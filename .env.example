# Example only: replace every YOUR... value outside Git.
# ASP.NET Core does not load this file automatically. Supply environment
# variables through your shell/service, or use .NET User Secrets locally.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5088
Database__Provider=MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=YOUR_DATABASE_USER
DB_PASS=YOUR_DATABASE_PASSWORD
DB_NAME=YOUR_DATABASE_NAME
SiteAuthentication__BaseUrl=https://YOUR_SITE_DOMAIN
SiteAuthentication__VerifyPath=/api/login
Agents__Gemini__ApiKey=YOURAPIKEY
Agents__Groq__ApiKey=YOURAPIKEY
Agents__KeyStorePath=/etc/mtk-chat/agent-keys.json
